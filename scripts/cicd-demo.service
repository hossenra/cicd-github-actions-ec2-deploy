[Unit]
Description=CI/CD Demo Node.js Application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/cicd-demo/app
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/cicd-demo/app/src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
